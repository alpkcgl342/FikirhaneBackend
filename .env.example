# .env olarak kopyalayıp doldurun. Değerler: Supabase Dashboard > proje > "Connect".

# Sunucu
PORT=3000
# Virgülle birden fazla köken yazılabilir
CORS_ORIGIN=http://localhost:5173
# Web sitesinin adresi (e-posta doğrulamasından sonra buraya yönlendirilir)
WEB_URL=http://localhost:5173

# Veritabanı (Supabase PostgreSQL)
# Uygulama: Transaction pooler (port 6543) — Vercel gibi serverless ortamlar için
DATABASE_URL=postgresql://postgres.<proje-ref>:<db-sifresi>@<pooler-host>:6543/postgres
# Prisma CLI (migrate/seed): Session pooler (port 5432) veya doğrudan bağlantı
DIRECT_URL=postgresql://postgres.<proje-ref>:<db-sifresi>@<pooler-host>:5432/postgres

# Supabase Auth
SUPABASE_URL=https://<proje-ref>.supabase.co
# Publishable key (sb_publishable_...) — gizli değildir ama service_role/secret key ASLA buraya yazılmaz
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
